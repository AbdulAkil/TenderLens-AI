POSTGRES_DB=tenderlens
POSTGRES_USER=tenderlens
POSTGRES_PASSWORD=local-development-only
DATABASE_URL=postgresql+psycopg://tenderlens:local-development-only@postgres:5432/tenderlens
TED_API_BASE_URL=https://api.ted.europa.eu
TED_API_TIMEOUT_SECONDS=30
TED_API_MAX_RETRIES=3
TED_INGESTION_ENABLED=false
DOCUMENT_PROCESSING_ENABLED=false
EMBEDDING_ENABLED=false
EMBEDDING_PROVIDER=
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
LLM_ENABLED=false
LLM_PROVIDER=
OPENAI_LLM_MODEL=gpt-5.4-mini
RERANKER_PROVIDER=keyword
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
API_INTERNAL_URL=http://api:8000
ENVIRONMENT=development
SITE_URL=http://localhost:3000
SESSION_HOURS=24
TRIAL_DAYS=14
ADMIN_EMAILS=
SUPPORT_EMAIL=
EMAIL_PROVIDER=dry_run
EMAIL_API_KEY=
EMAIL_FROM=TenderLens <onboarding@example.invalid>
EMAIL_SANDBOX_RECIPIENTS=
EMAIL_REQUIRE_APPROVAL=true
EMAIL_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE=
STRIPE_PROFESSIONAL_PRICE=
STRIPE_BUSINESS_PRICE=
# Optional JSON override of plans. See docs/billing.md.
PLANS_JSON=
INGESTION_QUERY=buyer-country = BEL
INGESTION_MAX_NOTICES=500
WORKER_POLL_SECONDS=10
AI_MONTHLY_BUDGET_EUR=0
AI_CALL_RESERVATION_EUR=0.10
AI_INPUT_EUR_PER_MILLION=1
AI_OUTPUT_EUR_PER_MILLION=5
